---
const items = [
  {
    title: "Concierge de Servicios",
    description:
      "Te garantizamos la mejor experiencia Concierge de Servicios para con ello lograr la total satisfacción de tus necesidades.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`,
  },
  {
    title: "Mayor Rentabilidad",
    description:
      "Nuestro principal objetivo es ofrecer a nuestros clientes la mayor rentabilidad a través de nuestros servicios de arrendamiento puro.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
  },
  {
    title: "Experiencia y Respaldo",
    description:
      "Contamos con ejecutivos con más de 20 años de experiencia en el ramo financiero automotriz.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
  },
  {
    title: "Convenios y Alianzas",
    description:
      "Contamos con convenios con las principales plantas armadoras y alianzas con compañías aseguradoras.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  },
  {
    title: "Tecnología de Vanguardia",
    description:
      "Contamos con plataformas y sistemas operativos de vanguardia enfocados al servicio al cliente.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>`,
  },
  {
    title: "Planes Company-Car",
    description:
      "Desarrollo de planes Company-Car a la medida de tu empresa para la gestión inteligente de flotas.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17h10"/></svg>`,
  },
];
---

<section class="border-y border-border bg-muted">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        ¿Qué nos hace distintos?
      </h2>
      <p class="text-lg text-muted-foreground">
        <span class="font-semibold"
          >Más de 7,000 casos de éxito a nivel nacional</span
        >
      </p>
      <p class="mt-3 text-muted-foreground">
        Somos una empresa especializada en Arrendamiento Puro ofreciendo
        Soluciones de Vanguardia desde el 2014. Desde nuestros inicios hemos
        buscando la satisfacción de nuestros clientes logrando:
      </p>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <div class="flex flex-col">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="mt-5 text-base font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
